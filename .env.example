# Copy to .env.local and fill in. Never commit .env.local.
#
# Only NEXT_PUBLIC_* values reach the browser. Anything secret - the database
# URL, the Gemini key, the Clerk secret - must NOT carry that prefix, or it
# gets inlined into the client bundle where anyone can read it.

# --- Database ---------------------------------------------------------------
# Supabase / Neon pooler connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Set to "disable" only for a local Postgres without TLS.
DATABASE_SSL=require
# Optional: max pooled connections (default 10).
# DATABASE_POOL_MAX=10

# --- Google Gemini ----------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL=gemini-2.5-flash

# --- Clerk ------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Optional ---------------------------------------------------------------
# Canonical site URL, used for Open Graph metadata.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
